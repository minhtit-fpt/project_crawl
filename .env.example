# ── AES-256-CBC Encryption ────────────────────────────────────────────────────
# 32-byte key encoded as hex (64 hex chars)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
AES_SECRET_KEY=

# 16-byte IV encoded as hex (32 hex chars)
# Generate: python -c "import secrets; print(secrets.token_hex(16))"
AES_IV=

# ── Proxy (optional) ──────────────────────────────────────────────────────────
# Comma-separated list of proxy URLs
# Example: http://user:pass@proxy1:8080,http://user:pass@proxy2:8080
PROXY_LIST=

# ── Logging ───────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR (default: INFO)
LOG_LEVEL=INFO

# ── Database (optional, for future persistence) ───────────────────────────────
DATABASE_URL=
