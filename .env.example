# ── Proxy (optional) ──────────────────────────────────────────────────────────
# Comma-separated list of proxy URLs
# Example: http://user:pass@proxy1:8080,http://user:pass@proxy2:8080
PROXY_LIST=

# ── Logging ───────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR (default: INFO)
LOG_LEVEL=INFO

# ── MySQL Database ────────────────────────────────────────────────────────────
# Format: mysql://user:password@host:port/database
# For local dev: use localhost (e.g. mysql://crawler:password@localhost:3306/price_crawler)
DATABASE_URL=

# ── CMS API (required for --source api mode) ─────────────────────────────────
# Endpoint to fetch product list with SKUs and crawler URLs
CMS_API_URL=
# Auth token sent as request header: token: <value>
CMS_API_TOKEN=

# ── Pull API server config (used with: python main.py --serve) ────────────────
PULL_API_HOST=0.0.0.0
PULL_API_PORT=8080

# Bearer token for Pull API auth — CMS must send: Authorization: Bearer <token>
# Leave empty for development (no auth). REQUIRED for production.
PULL_API_TOKEN=
